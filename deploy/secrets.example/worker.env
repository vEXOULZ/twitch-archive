# secrets/worker.env (chmod 600)
ARCHIVE_DATABASE_URL=postgresql+asyncpg://archive_worker:CHANGE_ME@127.0.0.1:5432/archive
ARCHIVE_TWITCH_CLIENT_ID=
ARCHIVE_TWITCH_CLIENT_SECRET=
# Admin API bearer key (openssl rand -hex 32)
ARCHIVE_ADMIN_API_KEY=
# Google OAuth client (YouTube uploads)
ARCHIVE_GOOGLE_CLIENT_ID=
ARCHIVE_GOOGLE_CLIENT_SECRET=
ARCHIVE_GOOGLE_REDIRECT_URL=http://localhost:3031/admin/refreshtoken
