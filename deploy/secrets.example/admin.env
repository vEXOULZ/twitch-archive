# secrets/admin.env (chmod 600) - used only by operators, never mounted into a container
# Superuser URL for `alembic upgrade head`
ARCHIVE_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@127.0.0.1:5432/archive
# Role passwords for deploy/apply-roles.sh; must match secrets/api.env and secrets/worker.env
API_DB_PASSWORD=
WORKER_DB_PASSWORD=
