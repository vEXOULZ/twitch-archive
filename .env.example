# Non-secret settings shared by both services (copy to .env).
# Every setting is ARCHIVE_<NAME>; see README "Configuration" for the full list.
# Secrets (DB URLs, client secrets, admin key) go in secrets/api.env and secrets/worker.env.

ARCHIVE_CHANNEL=yourchannel
ARCHIVE_DOMAIN_NAME=vods.example.com
ARCHIVE_TIMEZONE=UTC
ARCHIVE_LOG_LEVEL=INFO

# numeric user id: https://api.twitch.tv/helix/users?login=<name>
ARCHIVE_TWITCH_ID=
ARCHIVE_TWITCH_USERNAME=yourchannel

# archive-api
ARCHIVE_API_PORT=3030

# archive-worker
ARCHIVE_ADMIN_PORT=3031
ARCHIVE_VOD_DOWNLOAD=true
ARCHIVE_CHAT_DOWNLOAD=true
ARCHIVE_LIVE_RECORD=false
ARCHIVE_MULTI_TRACK=false
ARCHIVE_YOUTUBE_UPLOAD=true
ARCHIVE_YOUTUBE_PUBLIC=false
ARCHIVE_YOUTUBE_DESCRIPTION=VOD
ARCHIVE_YOUTUBE_KEEPALIVE_HOURS=24
ARCHIVE_RESTRICTED_GAMES=[]
ARCHIVE_SPLIT_DURATION=10800
ARCHIVE_KEEP_HLS=false
ARCHIVE_KEEP_MP4=false

# Host directory mounted at /data in the worker (compose interpolation, not a setting)
ARCHIVE_HOST_DATA_DIR=./data
